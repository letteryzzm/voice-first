{
  "name": "voice-first",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "list-audio-devices": "ffmpeg -f avfoundation -list_devices true -i \"\" || true",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "desktop:engine": "tsx src/desktop/engine.ts",
    "desktop:engine:built": "node dist/desktop/engine.js",
    "desktop:build": "cargo build --manifest-path desktop/Cargo.toml",
    "desktop:run": "cargo run --manifest-path desktop/Cargo.toml"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.7.0",
    "@mariozechner/pi-agent-core": "^0.67.2",
    "@mariozechner/pi-ai": "^0.67.2",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
